{
  "id": "claude-code",
  "name": "Claude Code",
  "version": 1,
  "root": "~",
  "detect": [".claude", ".claude.json"],
  "processes": ["claude"],
  "credentials_in_keychain": true,
  "conversations_glob": ".claude/projects/*/*.jsonl",
  "categories": {
    "conversations": [".claude/projects/", ".claude/sessions/", ".claude/history.jsonl", ".claude/file-history/"],
    "config": [".claude/settings.json", ".claude/settings.local.json", ".claude/CLAUDE.md", ".claude/AGENTS.md", ".claude/skills/",
               ".claude/hooks/", ".claude/agents/", ".claude/commands/", ".claude.json",
               ".claude/plugins/installed_plugins.json", ".claude/plugins/known_marketplaces.json", ".claude/plugins/blocklist.json"],
    "memories": [".claude/memory/", ".claude/todos/"],
    "credentials": []
  },
  "sqlite": [".claude/*.db", ".claude/*.sqlite"],
  "exclude": ["cache/", "telemetry/", "shell-snapshots/", "session-env/", "spares/", "backups/", "statsig/", "node_modules/", ".DS_Store"],
  "reinstall": [".claude/plugins/"]
}
