"cli.git.help" = "Usage: cairn git [options]\n\nFinds local branches whose remote branch was deleted (\"gone\") and stale worktrees, then optimizes repositories.\nSIMULATION by default: nothing changes without --apply.\n\n  --root DIR           Folder to scan (default: tracked folders)\n  --only PATTERN       Only repositories whose path contains PATTERN\n  --fetch              git fetch --prune first (network)\n  --apply              Delete selected branches and worktrees, then git gc\n  --yes                Do not ask for confirmation\n  --include-unmerged   With --apply: also delete unmerged gone branches\n  --prune-now          With --apply: free space now (deleted branches can no longer be recovered)\n  --no-gc              Do not run git gc\n  --worktrees-only     Only worktrees\n  --stale-days N       Worktree inactive after N days\n  --include-at-risk    Also remove worktrees with uncommitted or unpushed work\n  --report FILE        Write the TSV report\n  --json               Machine-readable output";
