{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "generateNotesCmd": "Cairn/scripts/release-notes.sh --footer '${lastRelease.gitHead}'",
        "prepareCmd": "desktop/scripts/semantic-release/release-prepare.sh '${nextRelease.version}' '${lastRelease.gitHead}'"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["desktop/package.json", "Cairn/VERSION", "CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [{ "path": "desktop/release/Cairn-*.zip" }, { "path": "desktop/release/Cairn-*.zip.sha256" }],
        "releaseNameTemplate": "Cairn ${nextRelease.version}",
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
